{
  "name": "mystocklog",
  "version": "2.10.10",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "sync:toss": "node --env-file=.env scripts/sync-toss-to-production.mjs",
    "refresh:daily": "node --env-file=.env scripts/refresh-and-sync.mjs"
    ,"backtest:phase1": "node --env-file=.env backtest/phase1.mjs"
    ,"backtest:phase1-5": "node --env-file=.env backtest/phase1_5.mjs"
    ,"backtest:phase1-7": "node --env-file=.env backtest/phase1_7.mjs"
    ,"backtest:phase1-8": "node --env-file=.env backtest/phase1_8.mjs"
    ,"backtest:phase1-8-linked": "node --env-file=.env backtest/phase1_8_linked.mjs"
    ,"backtest:phase2": "node --env-file=.env backtest/phase2.mjs"
    ,"backtest:phase3": "node --env-file=.env backtest/phase3.mjs"
    ,"backtest:phase3-5": "node --env-file=.env backtest/phase3_5.mjs"
    ,"backtest:phase3-7": "node --env-file=.env backtest/phase3_7.mjs"
    ,"backtest:phase3-8": "node --env-file=.env backtest/phase3_8.mjs"
    ,"backtest:phase3-9": "node --env-file=.env backtest/phase3_9.mjs"
    ,"backtest:phase3-10": "node --env-file=.env backtest/phase3_10.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "latest",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "wrangler": "4.92.0"
  }
}
